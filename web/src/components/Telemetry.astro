---
// Browser-side analytics and error reporting, both switched on /admin (site settings).
// Their origins are added to this page's CSP; anything not switched on stays blocked.
const { sentry, umami } = Astro.locals.siteSettings;
const sentryDsn = sentry.browser && sentry.dsn ? sentry.dsn : null;
const umamiScript = umami.enabled && umami.scriptUrl ? umami.scriptUrl : null;

if (umamiScript) {
  const origin = new URL(umamiScript).origin;
  Astro.csp?.insertScriptResource(origin);
  Astro.csp?.insertDirective(`connect-src ${origin}`);
}
if (sentryDsn) Astro.csp?.insertDirective(`connect-src ${new URL(sentryDsn).origin}`);
---

{umamiScript && <script is:inline defer src={umamiScript} data-website-id={umami.websiteId} />}
{sentryDsn && <meta name="sentry-dsn" content={sentryDsn} />}

<script>
  // @sentry/browser is a separate chunk, fetched only when browser reporting is on.
  const dsn = document.querySelector<HTMLMetaElement>('meta[name="sentry-dsn"]')?.content;
  if (dsn) {
    import("@sentry/browser").then((Sentry) => Sentry.init({ dsn }));
  }
</script>
