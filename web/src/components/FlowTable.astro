---
import type { FlowRow } from "../lib/playground";
import LogRow from "./LogRow.astro";

interface Props {
  rows: readonly FlowRow[];
}
const { rows } = Astro.props;
// Newest first, as the script prepends.
const shown = [...rows].reverse();
const head = "px-3 py-2 align-top font-medium";
---

<div class="overflow-x-auto rounded-xl border border-border bg-surface">
  <table class="w-full min-w-[36rem] text-left text-sm">
    <caption class="px-3 pt-3 pb-1 text-left font-semibold">Audit log</caption>
    <thead>
      <tr class="border-b border-border text-xs text-muted">
        <th scope="col" class={head}>Time</th>
        <th scope="col" class={head}>Who</th>
        <th scope="col" class={head}>Request</th>
        <th scope="col" class={head}>Verdict</th>
        <th scope="col" class={head}>To / stopped at</th>
      </tr>
    </thead>
    <tbody data-log data-span={Math.max(0, ...rows.map((r) => r.at))}>
      {shown.map((r) => <LogRow row={r} />)}
    </tbody>
  </table>
</div>
<template data-logrow><LogRow row={null} /></template>
