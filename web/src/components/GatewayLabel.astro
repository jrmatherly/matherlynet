---
import { FONT, type Label } from "../lib/gateway-path";
// One SVG label from GatewayPath's figure.
interface Props {
  label: Label;
}
const { label: t } = Astro.props;
const cls = FONT[t.tone].class;
---

{
  t.lines.length === 1 ? (
    <text class={cls} x={t.x} y={t.lines[0].y} text-anchor={t.anchor}>{t.lines[0].text}</text>
  ) : (
    <text class={cls} text-anchor={t.anchor}>{t.lines.map((l) => <tspan x={t.x} y={l.y}>{l.text}</tspan>)}</text>
  )
}
