---
interface Props {
  // Year label in the rail column; empty string for an unlabelled entry (the changelog's hero).
  year: string;
  // Current entry: accent dot and foreground year.
  now?: boolean;
  // Small line above the heading (role and dates).
  meta?: string;
  id?: string;
}
const { year, now = false, meta, id } = Astro.props;
---

<!-- display: contents, so the year and body cells sit directly in the page's two-column rail grid. -->
<!-- The anchor id sits on the body cell: a display:contents box can't be scrolled to. -->
<section data-now={String(now)} class="contents">
  <div class:list={["relative border-r border-border pt-1 text-sm tabular-nums sm:text-base", now ? "text-foreground" : "text-muted"]}>
    <span class="display text-base font-normal sm:text-lg">{year}</span>
    <span
      aria-hidden="true"
      class:list={["absolute top-3 -right-[5px] size-2.5 rounded-full border-2", now ? "border-accent bg-accent" : "border-muted bg-background"]}
    />
  </div>
  <div id={id} class="grid scroll-mt-24 content-start gap-3.5 pb-12 pl-5 sm:pl-10">
    {meta && <p class="text-sm text-muted">{meta}</p>}
    <slot />
  </div>
</section>
