---
import { metrics } from "../data/profile";
---

<section aria-labelledby="status-title" class="relative rounded-2xl border border-border bg-surface p-5 shadow-[0_24px_60px_-30px_color-mix(in_srgb,var(--accent)_45%,transparent)]">
  <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
    <h2 id="status-title" class="font-mono text-xs tracking-wider text-muted uppercase">Platform status</h2>
    <span class="inline-flex items-center gap-2 font-mono text-xs text-success">
      <span class="size-1.5 rounded-full bg-success shadow-[0_0_0_4px_color-mix(in_srgb,var(--success)_22%,transparent)]" aria-hidden="true"></span>
      In production
    </span>
  </div>
  <dl class="grid grid-cols-2">
    {
      metrics.map((m, i) => (
        <div class:list={["grid gap-0.5 border-t border-border py-4", i % 2 === 0 ? "border-r pr-3" : "pl-4"]}>
          <dt class="order-1 font-mono text-xs text-muted">{m.label}</dt>
          <dd class="order-2 text-3xl font-extrabold tracking-tight tabular-nums">{m.value}</dd>
          <dd class="order-3 text-sm text-muted">{m.detail}</dd>
        </div>
      ))
    }
  </dl>
</section>
