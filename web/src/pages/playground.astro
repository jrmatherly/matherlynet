---
import Cta from "../components/Cta.astro";
import GatewayConsole from "../components/GatewayConsole.astro";
import Base from "../layouts/Base.astro";
import { inlineLink } from "../lib/form";
import { ogImage } from "../lib/og";
import { parseScenarioId, SCENARIO_IDS } from "../lib/playground";
import { liveModelOn } from "../lib/playground-io";

const tried = parseScenarioId(Astro.url.searchParams.get("try")) ?? SCENARIO_IDS[0];
const live = liveModelOn();
const description = live
  ? "The AI gateway's checks (SSO, rate limits, guardrails, cache and routing) on simulated examples in your browser, and on your own request, which a small self-hosted model answers."
  : "A simulation of the AI gateway's checks (SSO, rate limits, guardrails, cache and routing) running on your text, in your browser.";
const lead = live
  ? "The checks every model call meets at work. The examples run in your browser. Your own request runs for real."
  : "The checks every model call meets at work, running on your text, in your browser.";
---

<Base title="Playground" description={description} image={ogImage("playground", Astro.locals.siteSettings)}>
  <div class="mx-auto grid max-w-6xl gap-14 px-4 pt-16 sm:px-6 sm:pt-20">
    <header class="grid max-w-3xl gap-3">
      <h1 class="display text-4xl sm:text-5xl">Send a request through the gateway.</h1>
      <p class="text-lg text-muted">{lead}</p>
    </header>
    <GatewayConsole picked={tried} live={live} />
    <p>How the real gateway was built: <a href="/work" class={inlineLink}>Work</a></p>
    <Cta title="If a platform has to work on Monday, let's talk." body="About the role, the stack, or how we went from LiteLLM to an in‑house gateway." />
  </div>
</Base>
