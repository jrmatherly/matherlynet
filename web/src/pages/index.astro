---
import Perspectives from "../components/Perspectives.astro";
import StatusPanel from "../components/StatusPanel.astro";
import WorkCard from "../components/WorkCard.astro";
import { resumeUrl, work } from "../data/profile";
import Base from "../layouts/Base.astro";
import { ogImage } from "../lib/og";
import { person } from "../lib/site";
---

<Base title={person.name} type="profile" image={ogImage("home")}>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(var(--border)_1px,transparent_1px),linear-gradient(90deg,var(--border)_1px,transparent_1px)] bg-size-[56px_56px] opacity-50 mask-[radial-gradient(ellipse_at_75%_30%,#000_0%,transparent_65%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.15fr_1fr] lg:py-28">
      <div class="grid gap-6">
        <p class="inline-flex w-fit items-center gap-2 rounded-full border border-border bg-accent-soft px-3 py-1.5 font-mono text-xs">
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>{person.locality} · AI platform &amp; infrastructure
        </p>
        <h1 class="text-5xl leading-[0.98] font-extrabold tracking-tighter text-balance sm:text-7xl">
          I build the platforms enterprise <span class="text-accent">AI runs on.</span>
        </h1>
        <p class="max-w-xl text-lg text-muted">
          16+ years at The Aaron's Company, from store networks to an AI Gateway serving about 2 billion tokens a month, with
          security, governance and cost accounting built in.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/work" class="rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-accent-foreground">See the work</a>
          <a href={resumeUrl} class="rounded-full border border-border bg-surface-2 px-5 py-2.5 text-sm font-semibold">View résumé</a>
        </div>
      </div>
      <StatusPanel />
    </div>
  </section>

  <section class="border-y border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <Perspectives />
    </div>
  </section>

  <section aria-labelledby="work-title" class="mx-auto grid max-w-6xl gap-8 px-4 py-16 sm:px-6 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="grid gap-2">
        <p class="font-mono text-xs tracking-wider text-muted uppercase">Selected work</p>
        <h2 id="work-title" class="text-3xl font-extrabold tracking-tight text-balance sm:text-4xl">Platforms that run in production, not in slides.</h2>
      </div>
      <a href="/work" class="text-sm font-semibold underline underline-offset-4">All work →</a>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {work.slice(0, 3).map((item) => <WorkCard item={item} />)}
    </div>
  </section>
</Base>
