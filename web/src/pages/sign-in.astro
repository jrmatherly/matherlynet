---
import AuthCard from "../components/AuthCard.astro";
import { enabledProviders } from "../lib/auth";
import { field, label, primary, secondary, textLink } from "../lib/form";

if (Astro.locals.user) return Astro.redirect("/account");

const providerLabel = { github: "GitHub", google: "Google" } as const;
---

<AuthCard title="Sign in" description="Sign in to your account.">
  <form id="sign-in-form" class="grid gap-3">
    <label class={label}>
      Email
      <input name="email" type="email" required autocomplete="email" class={field} />
    </label>
    <label class={label}>
      Password
      <input name="password" type="password" required autocomplete="current-password" class={field} />
    </label>
    <button class={primary}>Sign in</button>
  </form>
  {
    enabledProviders.length > 0 && (
      <div class="grid grid-cols-2 gap-2">
        {enabledProviders.map((p) => (
          <button type="button" data-provider={p} class={secondary}>
            {providerLabel[p]}
          </button>
        ))}
      </div>
    )
  }
  <p id="message" role="alert" class="text-sm text-danger empty:hidden"></p>
  <p class="flex flex-wrap justify-between gap-2 text-sm text-muted">
    <a href="/forgot-password" class={textLink}>Forgot password?</a>
    <span>No account? <a href="/sign-up" class={textLink}>Sign up</a></span>
  </p>
</AuthCard>

<script>
  import { authClient } from "../lib/auth-client";

  const message = document.querySelector("#message")!;

  document.querySelector<HTMLFormElement>("#sign-in-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = new FormData(e.currentTarget as HTMLFormElement);
    const { error } = await authClient.signIn.email({
      email: String(form.get("email")),
      password: String(form.get("password")),
    });
    if (!error) return location.assign("/account");
    // 403: the email isn't verified yet; better-auth has just sent a fresh link.
    message.textContent =
      error.status === 403 ? "Verify your email first. We've sent you a new link." : (error.message ?? "Sign-in failed");
  });

  document.querySelectorAll<HTMLButtonElement>("[data-provider]").forEach((button) =>
    button.addEventListener("click", async () => {
      const { error } = await authClient.signIn.social({ provider: button.dataset.provider!, callbackURL: "/account" });
      if (error) message.textContent = error.message ?? "Sign-in failed";
    }),
  );
</script>
