---
import AuthCard from "../components/AuthCard.astro";
import { field, label, primary, textLink } from "../lib/form";

// better-auth redirects here from the emailed link with ?token=… (or ?error=INVALID_TOKEN).
const token = Astro.url.searchParams.get("token");
---

<AuthCard title="Choose a new password" description="Set a new password.">
  {
    token ? (
      <form id="reset-form" method="post" data-token={token} class="grid gap-3">
        <label class={label}>
          New password
          <input name="password" type="password" required minlength="12" maxlength="128" autocomplete="new-password" class={field} />
        </label>
        <button class={primary}>Set password</button>
      </form>
    ) : (
      <p class="text-sm text-danger">This reset link is invalid or has expired.</p>
    )
  }
  <p id="message" role="status" class="text-sm empty:hidden"></p>
  <p class="text-sm text-muted">
    <a href="/forgot-password" class={textLink}>Request a new link</a> · <a href="/sign-in" class={textLink}>Sign in</a>
  </p>
</AuthCard>

<script>
  import { authClient } from "../lib/auth-client";

  // The form carries the token (data-token): drop it from the address bar so history, later Referer headers and
  // error reports never see it. Reloading then shows the "invalid or expired" message; the email has the link.
  if (new URLSearchParams(location.search).has("token")) history.replaceState(null, "", location.pathname);

  const message = document.querySelector<HTMLElement>("#message")!;

  document.querySelector<HTMLFormElement>("#reset-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formEl = e.currentTarget as HTMLFormElement;
    const { error } = await authClient.resetPassword({
      newPassword: String(new FormData(formEl).get("password")),
      token: formEl.dataset.token!,
    });
    message.classList.toggle("text-danger", Boolean(error));
    message.textContent = error ? (error.message ?? "Reset failed") : "Password updated. Sign in with your new password.";
    if (!error) formEl.remove();
  });
</script>
