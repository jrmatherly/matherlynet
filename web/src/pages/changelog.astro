---
import Availability from "../components/Availability.astro";
import Cta from "../components/Cta.astro";
import RailEntry from "../components/RailEntry.astro";
import { availability, career, contact, type Milestone, recruiterFacts, resumeUrl } from "../data/profile";
import Base from "../layouts/Base.astro";
import { ogImage } from "../lib/og";
import { person } from "../lib/site";

// The timeline page, newest first: each role's milestones (the years since it started), then the role at its start
// year. The perspectives live on the home page and the gateway's generations on /work.
const entries = career.flatMap((role): (Milestone & { meta?: string })[] => {
  const year = role.start.slice(-4);
  const meta = `${role.title}, ${year} to ${role.end?.slice(-4) ?? "now"}`;
  return [...(role.milestones ?? []), { year, meta, heading: role.heading, highlights: role.highlights }];
});
const link = "font-semibold underline decoration-accent decoration-2 underline-offset-4";
---

<Base title="Changelog" description="Twenty years at The Aaron's Company, newest first: roles, platforms and what each one changed." image={ogImage("changelog", Astro.locals.siteSettings)} type="profile">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid grid-cols-[3rem_1fr] pt-10 sm:grid-cols-[7rem_1fr]">
      <RailEntry year="">
        <div class="grid gap-8 md:grid-cols-[minmax(0,46rem)_132px] md:justify-start md:gap-10">
          <div class="grid gap-5">
            <h1 class="display max-w-[18ch] text-4xl sm:text-5xl lg:text-6xl">
              Twenty years keeping a 1,200&#8209;store company running. <em class="text-accent">Now it's AI, too.</em>
            </h1>
            <p class="max-w-[52ch] text-xl">
              I lead infrastructure and company-wide AI adoption at The Aaron's Company: the AI Gateway that about 2 billion tokens a month pass through, the MCP platform behind it, and the Kubernetes, network and data-center estate underneath.
            </p>
            <Availability text={availability} />
            <div class="flex flex-wrap items-center gap-x-7 gap-y-4">
              <a href={contact.href} rel="me noopener" class={link}>{contact.label}</a>
              <a href={resumeUrl} target="_blank" rel="noopener" class="font-medium text-muted underline decoration-border decoration-2 underline-offset-4">Read the résumé</a>
            </div>
          </div>
          <!-- The home page shows the portrait on phones; here it would sit alone under the links. -->
          <img src="/portrait.jpg" srcset="/portrait-320.jpg 320w, /portrait.jpg 648w" sizes="132px" width="648" height="648" alt={`Portrait of ${person.name}`} class="hidden aspect-square h-auto w-[132px] object-cover md:block" />
        </div>
        <dl class="mt-4 grid max-w-3xl grid-cols-[max-content_1fr] gap-x-5 gap-y-1.5 text-sm">
          {
            recruiterFacts.map((f) => (
              <>
                <dt class="text-muted">{f.term}</dt>
                <dd>{f.detail}</dd>
              </>
            ))
          }
        </dl>
      </RailEntry>

      {
        entries.map((entry, i) => (
          <RailEntry year={entry.year} now={i === 0} meta={entry.meta} id={i === 0 ? "work" : undefined}>
            <h2 class="display text-3xl">{entry.heading}</h2>
            {entry.summary && <p class="max-w-[62ch]">{entry.summary}</p>}
            <ul class="grid max-w-[62ch] list-disc gap-1.5 pl-5 text-muted marker:text-border">
              {entry.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            {i === 0 && (
              <p class="text-sm">
                <a href="/work" class={link}>The platforms in detail</a>
              </p>
            )}
          </RailEntry>
        ))
      }
    </div>

    <!-- The closing entry keeps the rail's text column so the grid holds after the rail ends. -->
    <div class="border-t border-foreground pl-[calc(3rem+1.25rem)] sm:pl-[calc(7rem+2.5rem)]">
      <Cta title="If a platform has to work on Monday, let's talk." body="About the role, the stack, or how we went from LiteLLM to an in‑house gateway." />
    </div>
  </div>
</Base>
