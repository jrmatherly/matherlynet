---
import AuthCard from "../components/AuthCard.astro";
import { saveSiteSettings } from "../lib/site-settings";
import { parseSettingsForm } from "../lib/settings-form";
import { field, label, primary, textLink } from "../lib/form";
import { PRO_PALETTES } from "../theme/palettes";

// Non-admins see the 404 page: the route doesn't advertise itself.
if (Astro.locals.user?.role !== "admin") return Astro.rewrite("/404");

const saved = Astro.url.searchParams.has("saved");
let error = "";
// Astro's origin check (security.checkOrigin) rejects cross-site POSTs.
if (Astro.request.method === "POST") {
  const result = parseSettingsForm(await Astro.request.formData());
  if ("settings" in result) {
    await saveSiteSettings(result.settings);
    // Redirect so the page (and its theme) renders from the new settings.
    return Astro.redirect("/admin?saved", 303);
  }
  error = result.error;
}

const current = Astro.locals.siteSettings;
const legend = "mb-1 text-lg font-bold";
const check = "flex items-center gap-2 text-sm";
const hint = "text-sm text-muted";
---

<AuthCard title="Site settings" description="Site-wide settings." wide>
  <p class={hint}>Changes reach every server replica within 30 seconds.</p>
  <form method="post" class="grid gap-6">
    <fieldset class="grid gap-3">
      <legend class={legend}>Theme</legend>
      <p class={hint}>The default for visitors who haven't picked one; a visitor's own choice still wins.</p>
      <div class="flex flex-wrap gap-4">
        <label class={check}>
          <input type="radio" name="theme" value="brand" checked={current.theme === "brand"} /> Brand (Signal)
        </label>
        <label class={check}>
          <input type="radio" name="theme" value="pro" checked={current.theme === "pro"} /> Pro
        </label>
      </div>
      <label class={label}>
        Pro palette
        <select name="proPalette" class={field}>
          {
            Object.entries(PRO_PALETTES).map(([key, name]) => (
              <option value={key} selected={current.proPalette === key}>
                {name}
              </option>
            ))
          }
        </select>
      </label>
    </fieldset>

    <fieldset class="grid gap-3">
      <legend class={legend}>Error monitoring (Sentry)</legend>
      <p class={hint}>
        Any Sentry-compatible DSN (Project settings → Client Keys). Only errors are sent; traces go to
        OpenTelemetry. The DSN is public by design: browsers see it.
      </p>
      <label class={label}>
        DSN
        <input name="sentryDsn" value={current.sentry.dsn ?? ""} placeholder="https://key@o0.ingest.sentry.io/0" class={field} />
      </label>
      <label class={check}><input type="checkbox" name="sentryServer" checked={current.sentry.server} /> Report server errors</label>
      <label class={check}><input type="checkbox" name="sentryBrowser" checked={current.sentry.browser} /> Report browser errors</label>
    </fieldset>

    <fieldset class="grid gap-3">
      <legend class={legend}>Analytics (Umami)</legend>
      <p class={hint}>
        Add the site in Umami (Settings → Websites), then copy the tracking code's script URL and website id.
      </p>
      <label class={label}>
        Script URL
        <input name="umamiScriptUrl" value={current.umami.scriptUrl ?? ""} placeholder="https://analytics.example.com/script.js" class={field} />
      </label>
      <label class={label}>
        Website id
        <input name="umamiWebsiteId" value={current.umami.websiteId ?? ""} placeholder="00000000-0000-0000-0000-000000000000" class={field} />
      </label>
      <label class={check}><input type="checkbox" name="umamiEnabled" checked={current.umami.enabled} /> Track page views</label>
    </fieldset>

    <button class={primary}>Save</button>
  </form>
  {saved && <p role="status" class="text-sm text-success">Saved.</p>}
  {error && <p role="alert" class="text-sm text-danger">{error}</p>}
  <p class="text-sm"><a href="/account" class={textLink}>← Account</a></p>
</AuthCard>
