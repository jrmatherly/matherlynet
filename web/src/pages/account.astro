---
import AuthCard from "../components/AuthCard.astro";
import { auth } from "../lib/auth";
import { primary, secondary, textLink } from "../lib/form";

const { user, session } = Astro.locals;
if (!user || !session) return Astro.redirect("/sign-in");

const headers = Astro.request.headers;
const sessions = await auth.api.listSessions({ headers });

// Revocation runs here by session id, so other devices' tokens never reach the page.
// Astro's origin check (security.checkOrigin) rejects cross-site POSTs.
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (form.get("action") === "revoke-others") {
    await auth.api.revokeOtherSessions({ headers });
  } else {
    const target = sessions.find((s) => s.id === form.get("id") && s.id !== session.id);
    if (target) await auth.api.revokeSession({ body: { token: target.token }, headers });
  }
  return Astro.redirect("/account", 303);
}

// Rendered on the server, whose zone isn't the visitor's: say which zone the time is in. (dateStyle/timeStyle
// can't be combined with timeZoneName, so the components are spelled out: "Oct 1, 2026, 8:10 PM UTC".)
const when = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  hour: "numeric",
  minute: "2-digit",
  timeZone: "UTC",
  timeZoneName: "short",
});
const others = sessions.filter((s) => s.id !== session.id);
---

<AuthCard title="Your account" description="Your account and active sessions." wide>
  <p class="text-sm">
    Signed in as <span class="font-semibold">{user.email}</span>
    {user.role === "admin" && <> · <a href="/admin" class={textLink}>Site settings</a></>}
  </p>

  <h2 class="mt-2 text-lg font-bold">Sessions</h2>
  <ul class="grid gap-2">
    {
      [session, ...others].map((s) => (
        <li class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-border bg-background p-3 text-sm">
          <div class="grid gap-0.5">
            <span class="font-semibold">
              {s.userAgent ?? "Unknown device"}
              {s.id === session.id && <span class="ml-1 font-normal text-success">(this device)</span>}
            </span>
            <span class="text-muted">
              {s.ipAddress ?? "Unknown IP"} · signed in {when.format(new Date(s.createdAt))}
            </span>
          </div>
          {s.id !== session.id && (
            <form method="post">
              <input type="hidden" name="id" value={s.id} />
              <button class={secondary}>Revoke</button>
            </form>
          )}
        </li>
      ))
    }
  </ul>

  <div class="flex flex-wrap gap-2">
    {
      others.length > 0 && (
        <form method="post">
          <input type="hidden" name="action" value="revoke-others" />
          <button class={secondary}>Sign out other devices</button>
        </form>
      )
    }
    <button id="sign-out" type="button" class={primary}>Sign out</button>
  </div>
  <p id="sign-out-message" role="alert" class="text-sm text-danger empty:hidden"></p>
</AuthCard>

<script>
  import { authClient } from "../lib/auth-client";

  const message = document.querySelector("#sign-out-message")!;
  const button = document.querySelector<HTMLButtonElement>("#sign-out")!;
  button.addEventListener("click", async () => {
    message.textContent = "";
    button.disabled = true;
    // The client resolves an HTTP error as { error } and rejects only when the request never completes
    // (checked on @better-fetch/fetch 1.3.2).
    const { error } = await authClient.signOut().catch(() => ({ error: { message: "" } }));
    if (!error) return location.assign("/");
    button.disabled = false;
    message.textContent = error.message || "Sign-out failed. Try again.";
  });
</script>
