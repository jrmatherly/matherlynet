---
import AuthCard from "../components/AuthCard.astro";
import { field, label, primary, textLink } from "../lib/form";
---

<AuthCard title="Reset your password" description="Request a password reset link.">
  <form id="forgot-form" method="post" class="grid gap-3">
    <label class={label}>
      Email
      <input name="email" type="email" required autocomplete="email" class={field} />
    </label>
    <button class={primary}>Send reset link</button>
  </form>
  <p id="message" role="status" class="text-sm empty:hidden"></p>
  <p class="text-sm text-muted"><a href="/sign-in" class={textLink}>Back to sign in</a></p>
</AuthCard>

<script>
  import { authClient } from "../lib/auth-client";
  import { whileBusy } from "../lib/form";

  const message = document.querySelector<HTMLElement>("#message")!;

  document.querySelector<HTMLFormElement>("#forgot-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formEl = e.currentTarget as HTMLFormElement;
    const form = new FormData(formEl);
    const { error } = await whileBusy(formEl, () =>
      authClient.requestPasswordReset({
        email: String(form.get("email")),
        redirectTo: "/reset-password",
      }),
    );
    message.setAttribute("role", error ? "alert" : "status");
    message.classList.toggle("text-danger", Boolean(error));
    message.textContent = error
      ? (error.message ?? "Something went wrong")
      : "If an account uses that email, a reset link is on its way.";
  });
</script>
