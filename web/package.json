{
  "name": "matherlynet-web",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node migrate.mjs && astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node migrate.mjs && node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "auth generate --config src/lib/auth.ts --output src/db/auth-schema.ts --yes && drizzle-kit generate"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@takumi-rs/core": "2.14.0",
    "astro": "7.3.5",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "tailwindcss": "4.3.3",
    "takumi-js": "2.14.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/pg": "8.23.1",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
