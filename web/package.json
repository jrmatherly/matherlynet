{
  "name": "matherlynet-web",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node migrate.mjs && astro dev",
    "build": "astro build",
    "check": "astro check",
    "start": "node migrate.mjs && node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "auth generate --config src/lib/auth.ts --output src/db/auth-schema.ts --yes && drizzle-kit generate"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "astro": "7.3.5",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/pg": "8.23.1",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
