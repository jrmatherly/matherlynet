{
  "name": "matherlynet-web",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node migrate.mjs && node --import ./otel.mjs node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "start": "node start.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "auth generate --config src/lib/auth.ts --output src/db/auth-schema.ts --yes && drizzle-kit generate"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.5",
    "@astrojs/node": "11.1.12",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/sdk-node": "0.301.2",
    "@sentry/browser": "11.12.0",
    "@sentry/core": "11.12.0",
    "@sentry/node": "11.12.0",
    "@tailwindcss/vite": "4.3.5",
    "@takumi-rs/core": "2.20.0",
    "astro": "7.4.11",
    "better-auth": "1.7.22",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "tailwindcss": "4.3.5",
    "takumi-js": "2.20.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0",
    "@sentry/bundler-plugins": "11.12.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "auth": "1.7.22",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
