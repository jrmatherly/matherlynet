// Renovate version updates. Security fixes are separate: GitHub's Dependabot alerts and security updates
// (repository settings), which ignore the release-age wait.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Workflow actions stay pinned to commit SHAs with a "# vX.Y.Z" comment.
    "helpers:pinGitHubActionDigests",
    // Exact pins in both package.json files: a bump rewrites 1.2.3 to 1.2.4.
    ":pinAllExceptPeerDependencies",
    ":configMigration",
    "schedule:weekly",
  ],
  timezone: "America/New_York",
  // Renovate's own wait; pnpm's default guard is 1 day, and npm has none unless ~/.npmrc sets min-release-age.
  minimumReleaseAge: "7 days",
  // Dependabot security updates raise the fix PRs; Renovate would raise each one again.
  vulnerabilityAlerts: { enabled: false },
  lockFileMaintenance: { enabled: true, schedule: ["before 6am on monday"] },
  // The markdownlint-cli2 hook pin in .pre-commit-config.yaml (off by default in Renovate).
  "pre-commit": { enabled: true },
  packageRules: [
    {
      description: "AppHost (root npm project): one PR for minor and patch updates",
      matchFileNames: ["package.json"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "apphost minor and patch",
    },
    {
      description: "Web app (pnpm): one PR for minor and patch updates",
      matchFileNames: ["web/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "web minor and patch",
    },
    {
      description: "Workflow actions: one PR",
      matchManagers: ["github-actions"],
      groupName: "actions",
    },
    {
      description: "Aspire's generated transport imports vscode-jsonrpc/node.js, which 9.x removed",
      matchPackageNames: ["vscode-jsonrpc"],
      allowedVersions: "<9",
    },
    {
      description: "typescript-eslint and @astrojs/check peer ranges cap TypeScript at 6.0.x",
      matchPackageNames: ["typescript"],
      allowedVersions: "<6.1",
    },
    {
      description: "Types track the Node 24 runtime (CI, the Docker images)",
      matchPackageNames: ["@types/node"],
      allowedVersions: "<25",
    },
    {
      description: "Runner toolchain versions float on purpose (Node 24, .NET 10.0.x)",
      matchManagers: ["github-actions"],
      matchDepNames: ["node", "dotnet-sdk"],
      enabled: false,
    },
    {
      description: "The markdownlint-cli2 hook and the workflow's npx pin move together",
      matchDepNames: ["DavidAnson/markdownlint-cli2", "markdownlint-cli2"],
      groupName: "markdownlint-cli2",
    },
    {
      description: "Postgres in the AppHost and the image smoke test: one PR",
      matchDepNames: ["postgres"],
      matchDatasources: ["docker"],
      groupName: "postgres",
    },
    {
      description: "A Postgres major needs pg_upgrade on the Compose volume: list it on the dashboard, open a PR only when asked",
      matchDepNames: ["postgres"],
      matchDatasources: ["docker"],
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      description: "Aspire moves as one set through `aspire update` (/bump-deps), and the CLI pin has a checksum: list updates on the dashboard, open a PR only when asked. `aspire update` leaves the Compose dashboard image tag alone; this group's PR bumps it",
      matchPackageNames: ["/^Aspire\\./", "/^CommunityToolkit\\.Aspire\\./", "microsoft/aspire", "mcr.microsoft.com/dotnet/aspire-dashboard"],
      groupName: "aspire",
      dependencyDashboardApproval: true,
    },
  ],
  // Pins no built-in manager reads.
  customManagers: [
    {
      description: "The Sentry CLI that the image workflow runs with npx",
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/publish-images\\.yml$/"],
      matchStrings: ["npx --yes sentry@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "sentry",
      datasourceTemplate: "npm",
    },
    {
      description: "markdownlint-cli2 in the repo checks workflow and the config's $schema (keep them on the pre-commit hook's frozen version)",
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/repo-checks\\.yml$/", "/^\\.markdownlint-cli2\\.jsonc$/"],
      matchStrings: [
        "npx --yes markdownlint-cli2@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "markdownlint-cli2/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/schema",
      ],
      depNameTemplate: "markdownlint-cli2",
      datasourceTemplate: "npm",
    },
    {
      description: "The Postgres image the AppHost publishes and the image smoke test runs against",
      customType: "regex",
      managerFilePatterns: ["/^apphost\\.mts$/", "/^scripts/smoke-image\\.sh$/"],
      matchStrings: [
        "addPostgres\\('pg'\\)\\s*\\.withImageTag\\('(?<currentValue>[^']+)'\\)",
        "docker\\.io/library/postgres:(?<currentValue>\\d+\\.\\d+)",
      ],
      depNameTemplate: "postgres",
      datasourceTemplate: "docker",
    },
    {
      description: "The Aspire dashboard image published with Compose",
      customType: "regex",
      managerFilePatterns: ["/^apphost\\.mts$/"],
      matchStrings: ["withImage\\('(?<depName>mcr\\.microsoft\\.com/dotnet/aspire-dashboard)', \\{ tag: '(?<currentValue>[^']+)' \\}\\)"],
      datasourceTemplate: "docker",
    },
    {
      description: "Aspire hosting packages",
      customType: "jsonata",
      fileFormat: "json",
      managerFilePatterns: ["/^aspire\\.config\\.json$/"],
      matchStrings: ['$each(packages, function($v, $k) { {"depName": $k, "currentValue": $v} })'],
      datasourceTemplate: "nuget",
    },
    {
      description: "The Aspire CLI pinned in the workflows (bump ASPIRE_SHA512 with it)",
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.yml$/"],
      matchStrings: ["ASPIRE_VERSION: '(?<currentValue>[^']+)'"],
      depNameTemplate: "microsoft/aspire",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
  ],
}
